    "{\"source\":\"npm:pi-memory\",\"scope\":\"user\"}": "0.4.2",
    "{\"source\":\"npm:pi-cc-extensions\",\"scope\":\"user\"}": "1.0.21",
    "{\"source\":\"npm:@tintinweb/pi-subagents\",\"scope\":\"user\"}": "0.26.3"
  },
  "editorPaddingX": 1,
  "outputPad": 1,
